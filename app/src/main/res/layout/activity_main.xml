<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <com.lekozaur.ndiviewer.FitSurfaceView
            android:id="@+id/surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/status_no_source"
        android:textColor="#9AA0A6"
        android:textSize="18sp" />

    <!-- Left vertical icon bar: lista -> audio -> falsecolor -> histogram -> jezyk -->
    <LinearLayout
        android:id="@+id/leftBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="8dp"
        android:layout_marginTop="24dp"
        android:elevation="4dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btnSources"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sources"
            android:src="@drawable/ic_list"
            android:tint="#E8EAED" />

        <ImageButton
            android:id="@+id/btnMute"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mute"
            android:src="@drawable/ic_volume_off"
            android:tint="#E8EAED" />

        <ImageButton
            android:id="@+id/btnFalseColor"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="False color"
            android:src="@drawable/ic_falsecolor"
            android:tint="#E8EAED" />

        <ImageButton
            android:id="@+id/btnHistogram"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Histogram"
            android:src="@drawable/ic_histogram"
            android:tint="#E8EAED" />

        <ImageButton
            android:id="@+id/btnLang"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/language"
            android:src="@drawable/ic_language"
            android:tint="#E8EAED" />
    </LinearLayout>

    <!-- LIVE bar: red, narrow, right-aligned -->
    <TextView
        android:id="@+id/statusChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/chip_bg"
        android:elevation="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="@string/status_init"
        android:textColor="#E8EAED"
        android:textSize="13sp" />

    <!-- FalseColor scale (left, draggable, with numbers) -->
    <FrameLayout
        android:id="@+id/falseColorScaleContainer"
        android:layout_width="60dp"
        android:layout_height="220dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="70dp"
        android:background="#CC1A1A1F"
        android:elevation="6dp"
        android:visibility="gone">

        <com.lekozaur.ndiviewer.FalseColorScaleView
            android:id="@+id/falseColorScaleView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Draggable histogram overlay -->
    <FrameLayout
        android:id="@+id/histogramContainer"
        android:layout_width="160dp"
        android:layout_height="100dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:background="#CC1A1A1F"
        android:elevation="6dp"
        android:visibility="gone">

        <com.lekozaur.ndiviewer.HistogramView
            android:id="@+id/histogramView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/histogramDragHandle"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </FrameLayout>

    <!-- Histogram controls (size + alpha) -->
    <LinearLayout
        android:id="@+id/histogramControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:background="#CC1A1A1F"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Size"
            android:textColor="#E8EAED"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekHistSize"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:max="100"
            android:progress="50" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Alpha"
            android:textColor="#E8EAED"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekHistAlpha"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:max="100"
            android:progress="80" />
    </LinearLayout>

    <TextView
        android:id="@+id/statsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:fontFamily="monospace"
        android:padding="12dp"
        android:textColor="#8AB4F8"
        android:textSize="12sp" />
</FrameLayout>
