<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <com.lekozaur.ndiviewer.FitSurfaceView
            android:id="@+id/surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/status_no_source"
        android:textColor="#9AA0A6"
        android:textSize="18sp" />

    <!-- Left vertical icon bar: lista -> audio -> jezyk, not clipped -->
    <LinearLayout
        android:id="@+id/leftBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="8dp"
        android:layout_marginTop="24dp"
        android:elevation="4dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btnSources"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sources"
            android:src="@drawable/ic_list"
            android:tint="#E8EAED" />

        <ImageButton
            android:id="@+id/btnMute"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mute"
            android:src="@drawable/ic_volume_off"
            android:tint="#E8EAED" />

        <ImageButton
            android:id="@+id/btnLang"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/language"
            android:src="@drawable/ic_language"
            android:tint="#E8EAED" />
    </LinearLayout>

    <!-- LIVE bar: red, narrow, right-aligned -->
    <TextView
        android:id="@+id/statusChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/chip_bg"
        android:elevation="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="@string/status_init"
        android:textColor="#E8EAED"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/statsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:fontFamily="monospace"
        android:padding="12dp"
        android:textColor="#8AB4F8"
        android:textSize="12sp" />
</FrameLayout>
